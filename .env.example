# Where the product lives. The landing (neuronium.ai) links to these.
# The main call to action, the Platform block, every plan and the final block:
VITE_PLATFORM_URL=https://platform.neuronium.ai/
# The Knowledge Management button:
VITE_KM_URL=https://management.neuronium.ai/km

# Optional: a sales page for "Contact sales" on the Scale plan.
# Empty → the "Write to us" widget opens, about the Scale plan.
VITE_SALES_URL=

# Optional: where the "Write to us" widget posts { email, subject, message }.
# Empty → /api/contact (api/contact.js, a Vercel Function that emails support@neuronium.ai).
# mailto → no server: "Send" opens the visitor's mail app (GitHub Pages builds use this; see deploy-pages.yml).
# A form service's address (e.g. Formspree) → it posts there.
VITE_CONTACT_ENDPOINT=

# Server side (Vercel → Settings → Environment Variables, not VITE_):
#   RESEND_API_KEY  the Resend API key that sends the widget's messages (required for sending)
#   CONTACT_TO      where they go (default support@neuronium.ai)
#   CONTACT_FROM    the sender on a domain verified in Resend (default Neuronium <hello@neuronium.ai>)

# Optional: the legal pages in the footer. Empty → andre.technology/terms/ and /privacy/.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
