# Where "Get Early Access" leads. Must be a real, working destination
# (a sign-up page, form or contact). Defaults to the Andre AI Technologies
# contact address published on https://andre.technology/.
VITE_EARLY_ACCESS_URL=mailto:admin@andre.technology?subject=Neuronium%20Early%20Access

# Optional: where "Start Free Trial" on the Standard, Solo and Business plans leads
# (?plan=standard|solo|business is added). Empty → a pre-filled email to admin@andre.technology.
VITE_TRIAL_URL=

# Optional: where "Contact sales" on the Enterprise plan leads. Empty → an email to admin@andre.technology.
VITE_SALES_URL=

# Optional: where the idea form on the last block ("Run Your AI Business") sends ideas.
# When set, the form POSTs JSON { "idea": "...", "source": "neuronium-landing" } here.
# When empty, the form opens a pre-filled email to admin@andre.technology instead.
VITE_IDEA_ENDPOINT=
